# TokenRouter environment configuration. All values shown are examples and
# MUST be changed before production deployment. TokenRouter ships no default
# production passwords.

# Port
PORT=3000

# Frontend base URL (for links/redirects)
FRONTEND_BASE_URL=http://localhost:3000

# Debug
DEBUG=false
ENABLE_PPROF=false

# Database (SQLite is the zero-config default)
# SQLITE_PATH=/data/tokenrouter.db
# SQL_DSN=postgresql://root:change-me@postgres:5432/tokenrouter
# SQL_DSN=root:change-me@tcp(mysql:3306)/tokenrouter
# LOG_SQL_DSN=   # optional separate log database (or clickhouse://)
# Scheduled retention for the configured log sink uses the primary database
# clock and a durable cleanup task. Default 30; integer range 0-36500. A value
# of 0 disables scheduled retention only; root-triggered manual cleanup remains.
# LOG_RETENTION_DAYS=30
# Optional ClickHouse-native TTL safety net; integer range 0-36500, with 0 off.
# Missing, malformed, negative, or out-of-range values also disable it. This
# uses the ClickHouse server clock; keep it off for strict primary-clock retention.
# LOG_SQL_CLICKHOUSE_TTL_DAYS=0
# Both primary and separate log databases use these validated pool bounds.
# SQL_MAX_IDLE_CONNS=100   # 0-10000; must not exceed SQL_MAX_OPEN_CONNS
# SQL_MAX_OPEN_CONNS=1000  # 1-10000
# SQL_MAX_LIFETIME=60      # seconds, 0-2592000; 0 disables age-based closing
# Required once when an unmarked database contains provider IDs after 27 (or a
# legacy Jimeng task with platform 47). This is a stop-the-world migration:
# stop EVERY old TokenRouter node before starting the new binary, back up the
# database, then choose compact-v0 for early TokenRouter data or reference-v1
# for new-api/one-api-compatible data. Never perform this as a rolling upgrade;
# an old binary would interpret the renumbered provider credentials incorrectly.
# TOKENROUTER_CHANNEL_TYPE_CATALOG=reference-v1

# Cache
# REDIS_CONN_STRING=redis://:change-me@redis:6379
# REDIS_POOL_SIZE=10  # 1-10000; invalid configured values fail startup
# SYNC_FREQUENCY=60
# MEMORY_CACHE_ENABLED=true
# Optional automatic upstream balance refresh interval, in minutes. Disabled
# when unset; every sweep is cluster-singleton, cancellable, and skips
# multi-key channels.
# CHANNEL_UPDATE_FREQUENCY=30
# Optional delay between balance-provider requests, in seconds (default 0).
# POLLING_INTERVAL=0
# Optional model/vendor metadata mirror used by the root sync workflow.
# Requests use direct SSRF-checked connections, refuse redirects, and clamp
# these controls to 1-60 seconds, 1-8 attempts, and 1-16 MiB respectively.
# SYNC_UPSTREAM_BASE=https://basellm.github.io/llm-metadata
# SYNC_HTTP_TIMEOUT_SECONDS=10
# SYNC_HTTP_RETRY=3
# SYNC_HTTP_MAX_MB=10

# Relay
# End-to-end relay deadline in seconds. Non-positive values use the safe
# 10-minute default; values above 24 hours are capped.
# RELAY_TIMEOUT=600
# STREAMING_TIMEOUT=300
# Shared outbound connection-pool controls. Values are validated at startup;
# timeout is 1-86400 seconds and connection counts are 1-10000.
# RELAY_IDLE_CONN_TIMEOUT=90
# RELAY_MAX_IDLE_CONNS=500
# RELAY_MAX_IDLE_CONNS_PER_HOST=100
# TLS_INSECURE_SKIP_VERIFY=false
# Secondary encrypted emergency journal; the primary database is authoritative.
# JIMENG_RECOVERY_DIR=/data/jimeng-recovery
# OpenAI/Sora accepted-task emergency journal. Keep this on durable node-local
# storage; records are removed only after the provider identity is in SQL.
# VIDEO_TASK_RECOVERY_DIR=/data/video-task-recovery
# Current-first AES-GCM keyring shared by every node that may poll an async
# video task. Keep old keys until all in-flight tasks and journals are drained.
# ASYNC_TASK_ENCRYPTION_KEYS=2026q3=<32+-byte-current-secret>,2026q2=<32+-byte-old-secret>,session=<old-session-secret>
# JIMENG_RECOVERY_RETENTION_DAYS=7
# JIMENG_MAX_POLL_DAYS=7
# JIMENG_RECOVERY_PASS_SECONDS=45
# Optional current-first rotation keyring. Configure the identical list on every node,
# retain old keys until every in-flight task/journal exceeds the recovery horizon, and
# include session=<old SESSION_SECRET> while migrating legacy ciphertext.
# JIMENG_ENCRYPTION_KEYS=2026q3=<32+-byte-current-secret>,2026q2=<32+-byte-old-secret>
# Rolling upgrade note: modern Jimeng tasks use a fail-closed `jimeng-v2:`
# private-data format. Drain or route away old nodes before enabling traffic on
# new nodes. Old nodes return errors for nonterminal v2 fetches and can omit the
# result URL for terminal v2 tasks until every node is upgraded.

# Security
# SESSION_SECRET is required unless DEBUG=true. Generate one with: openssl rand -hex 32
# SESSION_SECRET=<generated-value-of-at-least-32-random-bytes>
# SESSION_COOKIE_SECURE=false
# Exact additional browser origins allowed for credentialed dashboard CORS and
# secure-cookie refresh/logout checks (comma-separated).
# SESSION_COOKIE_TRUSTED_URL=https://example.com
# TRUSTED_PROXIES=none
# SSRF_DISABLE=false   # set true ONLY for local dev when channels point at loopback
# Fixed-window request limits. Durations are seconds; invalid or non-positive
# values fall back to the safe defaults shown here.
# GLOBAL_API_RATE_LIMIT_ENABLE=true
# GLOBAL_API_RATE_LIMIT=360
# GLOBAL_API_RATE_LIMIT_DURATION=180
# CRITICAL_RATE_LIMIT_ENABLE=true
# CRITICAL_RATE_LIMIT=20
# CRITICAL_RATE_LIMIT_DURATION=1200
# SEARCH_RATE_LIMIT_ENABLE=true
# SEARCH_RATE_LIMIT=10
# SEARCH_RATE_LIMIT_DURATION=60
# Anonymous auth/webhook body cap in KiB (default 512, maximum 16384; 0 leaves
# only the process-wide 16 MiB ceiling enabled).
# ANONYMOUS_REQUEST_BODY_LIMIT_KB=512
# Dashboard session growth controls. Active sessions are capped per user; the
# issuance limit counts every session row created inside the window, including
# expired or revoked rows. Revoked retention is never shorter than that window.
# USER_SESSION_ACTIVE_LIMIT=50
# USER_SESSION_ISSUANCE_LIMIT=100
# USER_SESSION_ISSUANCE_WINDOW_SECONDS=86400
# USER_SESSION_REVOKED_RETENTION_DAYS=7
# USER_SESSION_HOURLY_ALERT_THRESHOLD=5000

# Registration
# Optionally create one unlimited API token in the same transaction as each
# new account. Disabled by default; token credentials use secure entropy and a
# generation failure aborts registration instead of leaving a partial account.
# GENERATE_DEFAULT_TOKEN=false

# Built-in OAuth sign-in. A method is advertised only when its client ID,
# client secret, authorization endpoint, token endpoint, and user-info endpoint
# are all available. GitHub, Discord, and LinuxDo have fixed safe defaults for
# the three endpoints; OIDC intentionally has none and requires all three.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# LINUXDO_CLIENT_ID=
# LINUXDO_CLIENT_SECRET=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTH_URL=https://identity.example.com/oauth2/authorize
# OIDC_TOKEN_URL=https://identity.example.com/oauth2/token
# OIDC_USER_INFO_URL=https://identity.example.com/oauth2/userinfo
